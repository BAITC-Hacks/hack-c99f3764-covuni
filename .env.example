# ==============================================================================
# Halyk Bank — Career Quest (Team 202453) Environment Configuration
# ==============================================================================

# LLM Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server & Network Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Data Storage
DATA_DIR=/app/data

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
AUTH_ENABLED=true

# Hackathon demo accounts. Set DEMO_ACCOUNTS_ENABLED=false for a deployment
# that must not create the public demo users.
DEMO_ACCOUNTS_ENABLED=true
DEMO_EMPLOYEE_USERNAME=demo.employee
DEMO_EMPLOYEE_PASSWORD=CareerQuest-Employee-2026!
DEMO_EMPLOYEE_ID=E0001
DEMO_HR_USERNAME=hr.manager
DEMO_HR_PASSWORD=CareerQuest-HR-2026!

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
